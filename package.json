{
  "name": "@leleou209/dsh-commander",
  "version": "4.0.0",
  "type": "module",
  "description": "给 DSH 会话配一位常驻指挥员：托管「算不算完成、能不能改目标、该不该问用户」三个判断点，全接管时按轮次驱动下一轮。A resident commander agent for DSH sessions that gates goal completion, goal edits and user questions.",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "icon.svg",
    "lib/client.js",
    "lib/commander.js",
    "lib/consult.js",
    "lib/docs.js",
    "lib/driver.js",
    "lib/gate.js",
    "lib/goal-link.js",
    "lib/handoff.js",
    "lib/llm.js",
    "lib/modes.js",
    "lib/preheat.js",
    "lib/prompt.js",
    "lib/protocol.js",
    "lib/route-ops.js",
    "lib/routes.js",
    "lib/session.js",
    "lib/store.js",
    "lib/tools.js",
    "test/client-render.mjs",
    "test/docs.mjs",
    "test/driver.mjs",
    "test/gate.mjs",
    "test/goal-link.mjs",
    "test/handoff.mjs",
    "test/invariants.mjs",
    "test/load.mjs",
    "test/modes.mjs",
    "test/preheat.mjs",
    "test/store.mjs",
    "README.md"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "author": "leleou209",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "commander",
    "agent-teams",
    "goal",
    "orchestration",
    "decision-delegation",
    "human-in-the-loop"
  ],
  "homepage": "https://github.com/leleou209/dsh-commander#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leleou209/dsh-commander.git"
  },
  "bugs": {
    "url": "https://github.com/leleou209/dsh-commander/issues"
  }
}
