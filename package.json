{
  "name": "@local/dsh-commander",
  "version": "3.1.4",
  "private": true,
  "type": "module",
  "description": "决策托管（dsh-commander）3.1.1 提纯版：建立并绑定一个常驻可续接的指挥员子agent，预热后待命；按接管挡位管住 goal 与问用户；全接管时自动交接。",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./icon": "./icon.svg"
  },
  "files": [
    "cordis.patch.yml",
    "icon.svg",
    "index.js",
    "lib/client.js",
    "lib/commander.js",
    "lib/consult.js",
    "lib/docs.js",
    "lib/driver.js",
    "lib/gate.js",
    "lib/goal-link.js",
    "lib/handoff.js",
    "lib/modes.js",
    "lib/preheat.js",
    "lib/prompt.js",
    "lib/protocol.js",
    "lib/routes.js",
    "lib/store.js",
    "lib/tools.js",
    "README.md",
    "test/client-render.mjs",
    "test/docs.mjs",
    "test/gate.mjs",
    "test/goal-link.mjs",
    "test/handoff.mjs",
    "test/invariants.mjs",
    "test/load.mjs",
    "test/modes.mjs",
    "test/preheat.mjs",
    "test/store.mjs"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
