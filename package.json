{
  "name": "@local/dsh-commander",
  "version": "2.9.28",
  "private": true,
  "type": "module",
  "description": "指挥员模式（dsh-commander）：一个长期在线、可续接的 Agent Teams teammate「指挥员」，负责架构设计、功能铺展与督察验收；可读全部文件、跑只读 shell 与受控检查命令、可写 doc 但默认不动手。",
  "license": "MIT",
  "author": "leleou209",
  "homepage": "https://github.com/leleou209/dsh-commander#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leleou209/dsh-commander.git"
  },
  "bugs": {
    "url": "https://github.com/leleou209/dsh-commander/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "agent-teams",
    "commander",
    "goal",
    "orchestration"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./transcript-window": "./transcript-window.js"
  },
  "files": [
    "index.js",
    "client.js",
    "protocol.js",
    "code-state.js",
    "state-store.js",
    "messages.js",
    "takeover.js",
    "handoff.js",
    "transcript-window.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "test/offline.mjs",
    "test/regressions.mjs",
    "test/state-store.mjs",
    "test/takeover.mjs",
    "test/handoff.mjs",
    "test/transcript-window.mjs",
    "INSTALL.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
