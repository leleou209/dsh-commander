    "lib/docs.js",
    "lib/driver.js",
    "lib/gate.js",
    "lib/goal-link.js",
    "lib/handoff.js",
    "lib/modes.js",
    "lib/preheat.js",
    "lib/prompt.js",
    "lib/protocol.js",
    "lib/routes.js",
    "lib/store.js",
    "lib/tools.js",
    "README.md",
    "test/client-render.mjs",
    "test/docs.mjs",
    "test/gate.mjs",
    "test/goal-link.mjs",
    "test/handoff.mjs",
    "test/invariants.mjs",
    "test/load.mjs",
    "test/modes.mjs",
    "test/preheat.mjs",
    "test/store.mjs"
